---
import { t, NAV, href, altHref } from "../i18n/index.js";
import { INSTAGRAM } from "../data/redes.js";
import IconeRede from "./IconeRede.astro";

const { lang, routeKey } = Astro.props;
const c = t(lang);
const alt = altHref(routeKey, lang);
---

<header class="cab">
  <div class="wrap cab__inner">
    <a class="cab__marca" href={href("home", lang)}>
      <img
        src="/brand/logo-time.png"
        alt=""
        width="640"
        height="609"
        decoding="async"
      />
      <span class="cab__nome">
        <strong>enactus</strong>
        <span>IFMA Imperatriz</span>
      </span>
    </a>

    <input type="checkbox" id="menu-toggle" class="cab__check" />
    <label for="menu-toggle" class="cab__hamburguer">
      <span class="visually-hidden">{c.nav.menuAbrir}</span>
      <span class="cab__barras" aria-hidden="true"></span>
    </label>

    <nav class="cab__nav" aria-label={c.site.nome}>
      <ul class="cab__lista">
        {
          NAV.map((key) => (
            <li>
              <a
                href={href(key, lang)}
                aria-current={key === routeKey ? "page" : undefined}
              >
                {c.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>

      {
        INSTAGRAM?.url && (
          <a
            class="cab__social"
            href={INSTAGRAM.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconeRede id="instagram" size={19} />
            <span class="cab__social-texto">{INSTAGRAM.handle}</span>
            <span class="visually-hidden">{c.nav.instagram}</span>
          </a>
        )
      }

      <!-- Seletor de idioma no formato de chave (switch).
           A bolinha marca o idioma atual; ao passar o mouse ou focar pelo
           teclado, ela desliza para o outro lado, mostrando o que acontece
           se a pessoa clicar. Tudo em CSS, sem JavaScript. -->
      <a
        class="idioma"
        href={alt}
        data-lang={lang}
        hreflang={lang === "pt" ? "en" : "pt"}
      >
        <span class="visually-hidden">{c.nav.trocarIdioma}</span>
        <span class="idioma__trilho" aria-hidden="true">
          <span class="idioma__bola"></span>
          <span class="idioma__rotulo" data-para="pt">PT</span>
          <span class="idioma__rotulo" data-para="en">EN</span>
        </span>
      </a>
    </nav>
  </div>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(253, 250, 244, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .cab__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .cab__marca {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }

  .cab__marca img {
    width: 2.6rem;
    height: auto;
  }

  .cab__nome {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .cab__nome strong {
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .cab__nome span {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .cab__nav {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .cab__lista {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  .cab__lista a {
    text-decoration: none;
    font-weight: 600;
    color: var(--ink-body);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .cab__lista a:hover {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }

  .cab__lista a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }

  /* ---- Instagram ---- */
  .cab__social {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-body);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-s);
    transition: color 0.15s var(--ease), background-color 0.15s var(--ease);
  }

  .cab__social:hover {
    color: var(--gold-deep);
    background: var(--gold-soft);
  }

  /* O @ do time só aparece no menu do celular, onde há espaço.
     No desktop fica só o ícone, para não competir com a navegação. */
  .cab__social-texto {
    display: none;
    font-weight: 600;
    font-size: var(--step-1);
  }

  /* ==================== Seletor de idioma (chave) ====================
     Curva de mola: passa um pouco do ponto final e volta, imitando o
     "bounce" de bibliotecas de animação. Sem isso o movimento fica seco. */
  .idioma {
    --largura-rotulo: 2.5rem;
    --mola: cubic-bezier(0.34, 1.56, 0.64, 1);

    display: inline-flex;
    text-decoration: none;
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
  }

  .idioma__trilho {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-warm);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    transition: border-color 0.25s var(--ease);
  }

  .idioma:hover .idioma__trilho,
  .idioma:focus-visible .idioma__trilho {
    border-color: var(--gold-deep);
  }

  /* ---- a bolinha que desliza ---- */
  .idioma__bola {
    position: absolute;
    top: 3px;
    left: 3px;
    width: var(--largura-rotulo);
    height: calc(100% - 6px);
    transform: translateX(0);
    transition: transform 0.55s var(--mola);
    will-change: transform;
  }

  .idioma__bola::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--gold);
    box-shadow: 0 1px 3px rgba(67, 42, 12, 0.28);
    transition: transform 0.16s var(--ease);
    /* Sem fill-mode de propósito: com "both" o último quadro da animação
       continuaria valendo e anularia o encolhimento do :active abaixo,
       porque animação vence declaração normal na cascata. */
    animation: idioma-entrada 0.6s var(--mola);
  }

  /* Posição de repouso: em cima do idioma que está sendo lido. */
  .idioma[data-lang="en"] .idioma__bola {
    transform: translateX(var(--largura-rotulo));
  }

  /* Ao passar o mouse ou focar, a bolinha vai para o outro lado.
     É a prévia do que vai acontecer no clique. */
  .idioma[data-lang="pt"]:hover .idioma__bola,
  .idioma[data-lang="pt"]:focus-visible .idioma__bola {
    transform: translateX(var(--largura-rotulo));
  }

  .idioma[data-lang="en"]:hover .idioma__bola,
  .idioma[data-lang="en"]:focus-visible .idioma__bola {
    transform: translateX(0);
  }

  /* No clique ela encolhe um pouco, dando resposta tátil. */
  .idioma:active .idioma__bola { transition-duration: 0.12s; }
  .idioma:active .idioma__bola::before { transform: scale(0.88); }

  /* ---- os dois rótulos ---- */
  .idioma__rotulo {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--largura-rotulo);
    padding-block: 0.3rem;
    color: var(--ink-muted);
    opacity: 0.55;
    transform: rotate(-9deg) scale(0.88);
    transition:
      color 0.3s var(--ease),
      opacity 0.3s var(--ease),
      transform 0.5s var(--mola);
  }

  /* O rótulo que está embaixo da bolinha fica reto, opaco e escuro. */
  .idioma[data-lang="pt"] .idioma__rotulo[data-para="pt"],
  .idioma[data-lang="en"] .idioma__rotulo[data-para="en"] {
    color: var(--ink);
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Durante o hover os papéis se invertem, acompanhando a bolinha. */
  .idioma[data-lang="pt"]:hover .idioma__rotulo[data-para="pt"],
  .idioma[data-lang="pt"]:focus-visible .idioma__rotulo[data-para="pt"],
  .idioma[data-lang="en"]:hover .idioma__rotulo[data-para="en"],
  .idioma[data-lang="en"]:focus-visible .idioma__rotulo[data-para="en"] {
    color: var(--ink-muted);
    opacity: 0.55;
    transform: rotate(9deg) scale(0.88);
  }

  .idioma[data-lang="pt"]:hover .idioma__rotulo[data-para="en"],
  .idioma[data-lang="pt"]:focus-visible .idioma__rotulo[data-para="en"],
  .idioma[data-lang="en"]:hover .idioma__rotulo[data-para="pt"],
  .idioma[data-lang="en"]:focus-visible .idioma__rotulo[data-para="pt"] {
    color: var(--ink);
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @keyframes idioma-entrada {
    0% { opacity: 0; transform: scale(0.5); }
    65% { opacity: 1; transform: scale(1.08); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* Quem configurou o sistema para reduzir animação vê o estado final
     direto, sem movimento. */
  @media (prefers-reduced-motion: reduce) {
    .idioma__bola,
    .idioma__rotulo { transition: none; }
    .idioma__bola::before { animation: none; }
  }

  /* ---- Menu mobile (sem JavaScript) ---- */
  .cab__check,
  .cab__hamburguer {
    display: none;
  }

  @media (max-width: 860px) {
    .cab__hamburguer {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1.5px solid var(--line-strong);
      border-radius: var(--radius-s);
      cursor: pointer;
    }

    .cab__barras,
    .cab__barras::before,
    .cab__barras::after {
      content: "";
      display: block;
      width: 1.15rem;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }

    .cab__barras::before { transform: translateY(-6px); }
    .cab__barras::after { transform: translateY(4px); }

    .cab__check:checked ~ .cab__hamburguer .cab__barras { background: transparent; }
    .cab__check:checked ~ .cab__hamburguer .cab__barras::before { transform: rotate(45deg); }
    .cab__check:checked ~ .cab__hamburguer .cab__barras::after { transform: rotate(-45deg) translateY(1px); }

    .cab__check:focus-visible ~ .cab__hamburguer {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    .cab__nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
      width: 100%;
      padding-block: var(--space-s) var(--space-m);
      border-top: 1px solid var(--line);
    }

    .cab__check:checked ~ .cab__nav { display: flex; }

    .cab__lista {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
      width: 100%;
    }

    .cab__lista a { font-size: var(--step-1); }

    .cab__social { padding-left: 0; }
    .cab__social-texto { display: inline; }
  }
</style>
