---
import { t } from "../../i18n/index.js";
import { GLOBAL } from "../../data/rede-enactus.js";

const { lang } = Astro.props;
const c = t(lang);
const e = c.enactus;
---

<!-- ============================== HERO ============================== -->
<section class="topo">
  <div class="wrap topo__inner">
    <p class="eyebrow">{e.hero.eyebrow}</p>
    <h1>{e.hero.titulo}</h1>
    <p class="lead">{e.hero.lead}</p>
  </div>
</section>

<!-- ============================ O QUE É ============================ -->
<section class="section-tight">
  <div class="wrap-narrow">
    <h2>{e.oQueE.titulo}</h2>
    <blockquote class="destaque">{e.oQueE.destaque}</blockquote>
    <div class="prose">
      {e.oQueE.paragrafos.map((p) => <p>{p}</p>)}
    </div>
    <p class="credo">{e.oQueE.credo}</p>
  </div>
</section>

<!-- ========================= MISSÃO / VISÃO ========================= -->
<section class="section section--warm">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{e.mvv.eyebrow}</p>
      <h2>{e.mvv.titulo}</h2>
    </div>
    <div class="mvv-grid">
      {
        e.mvv.itens.map((i) => (
          <article class="card mvv">
            <p class="mvv__rotulo">{i.rotulo}</p>
            <p class="mvv__texto">{i.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============================= MODELO ============================= -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{e.modelo.eyebrow}</p>
      <h2>{e.modelo.titulo}</h2>
      <p class="lead">{e.modelo.lead}</p>
    </div>
    <div class="comunidades">
      {
        e.modelo.comunidades.map((com) => (
          <article class="card comunidade">
            <span class="comunidade__seta" aria-hidden="true"></span>
            <h3>{com.titulo}</h3>
            <p>{com.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- =============================== ODS =============================== -->
<section class="section section--warm">
  <div class="wrap-narrow">
    <p class="eyebrow">{e.ods.eyebrow}</p>
    <h2>{e.ods.titulo}</h2>
    <p class="prose ods__texto">{e.ods.texto}</p>
  </div>
</section>

<!-- ============================= NÚMEROS ============================= -->
<section class="section section--ink">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{e.numeros.eyebrow}</p>
      <h2>{e.numeros.titulo}</h2>
    </div>
    <dl class="globais">
      {
        GLOBAL.map((n) => (
          <div>
            <dd data-contar>{n.valor}</dd>
            <dt>{e.numeros.rotulos[n.chave]}</dt>
          </div>
        ))
      }
    </dl>
    <p class="globais__nota">{e.numeros.nota}</p>
  </div>
</section>

<!-- ============================= JORNADA ============================= -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{e.jornada.eyebrow}</p>
      <h2>{e.jornada.titulo}</h2>
      <p class="lead">{e.jornada.lead}</p>
    </div>
    <ol class="trilha">
      {
        e.jornada.etapas.map((et) => (
          <li>
            <h3>{et.titulo}</h3>
            <p>{et.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ========================== OPORTUNIDADES ========================== -->
<section class="section section--warm">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{e.oportunidades.eyebrow}</p>
      <h2>{e.oportunidades.titulo}</h2>
      <p class="lead">{e.oportunidades.lead}</p>
    </div>
    <ul class="oportunidades">
      {e.oportunidades.itens.map((i) => <li>{i}</li>)}
    </ul>
  </div>
</section>

<!-- ============================ FONTES ============================ -->
<section class="section-tight">
  <div class="wrap-narrow fontes">
    <h2>{e.saibaMais.titulo}</h2>
    <p>{e.saibaMais.texto}</p>
    <p class="fontes__links">
      <a class="btn btn--ghost" href="https://enactus.org.br" target="_blank" rel="noopener noreferrer">
        {e.saibaMais.linkBrasil}
      </a>
      <a class="btn btn--ghost" href="https://enactus.org" target="_blank" rel="noopener noreferrer">
        {e.saibaMais.linkGlobal}
      </a>
    </p>
  </div>
</section>

<style>
  .topo {
    background:
      radial-gradient(70% 130% at 78% 0%, rgba(242, 182, 32, 0.24) 0%, rgba(242, 182, 32, 0) 60%),
      linear-gradient(180deg, var(--bg-warm) 0%, var(--bg) 100%);
    padding-block: var(--space-xl) var(--space-l);
  }

  .topo__inner > * + * { margin-top: var(--space-s); }
  .topo__inner .lead { max-width: 52ch; }

  /* --------------------------- DESTAQUE --------------------------- */
  .destaque {
    margin: var(--space-m) 0;
    padding: var(--space-m) var(--space-m) var(--space-m) var(--space-l);
    border-left: 6px solid var(--amarelo);
    background: var(--marinho);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--creme);
  }

  .credo {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 2px solid var(--line);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--teal-deep);
    max-width: var(--measure);
  }

  /* ------------------------------ MVV ------------------------------ */
  .mvv-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 760px) {
    .mvv-grid { grid-template-columns: 1fr; }
  }

  .mvv > * + * { margin-top: var(--space-xs); }

  .mvv__rotulo {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  .mvv__texto {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink);
    font-weight: 600;
  }

  /* --------------------------- COMUNIDADES --------------------------- */
  .comunidades {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1000px) {
    .comunidades { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .comunidades { grid-template-columns: 1fr; }
  }

  .comunidade > * + * { margin-top: var(--space-xs); }

  .comunidade__seta {
    display: block;
    width: 1.7rem;
    height: 1.7rem;
    background: var(--gold);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* ------------------------------ ODS ------------------------------ */
  .ods__texto { margin-top: var(--space-s); }

  /* ---------------------------- GLOBAIS ---------------------------- */
  .globais {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }

  .globais > div {
    border-top: 3px solid var(--gold);
    padding-top: var(--space-xs);
  }

  .globais dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink-on-dark);
  }

  .globais dt {
    margin-top: 0.25em;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
    color: var(--ink-on-dark-muted);
  }

  .globais__nota {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--ink-on-dark-muted);
    font-style: italic;
  }

  /* ----------------------------- TRILHA ----------------------------- */
  .trilha {
    list-style: none;
    padding: 0;
    counter-reset: passo;
    display: grid;
    gap: var(--space-m);
    max-width: 62rem;
  }

  .trilha li {
    counter-increment: passo;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-s);
    align-items: start;
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .trilha li:last-child { border-bottom: 0; padding-bottom: 0; }

  .trilha li::before {
    content: counter(passo, decimal-leading-zero);
    grid-row: span 2;
    font-size: var(--step-2);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--gold);
    line-height: 1;
  }

  .trilha h3 { grid-column: 2; }
  .trilha p { grid-column: 2; margin-top: var(--space-2xs); max-width: var(--measure); }

  /* -------------------------- OPORTUNIDADES -------------------------- */
  .oportunidades {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
    max-width: 68ch;
  }

  .oportunidades li {
    position: relative;
    padding-left: 2rem;
    padding-block: 0.35rem;
  }

  .oportunidades li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.85rem;
    height: 0.85rem;
    background: var(--gold);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* ----------------------------- FONTES ----------------------------- */
  .fontes > * + * { margin-top: var(--space-s); }
  .fontes p { max-width: var(--measure); }
  .fontes__links { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
</style>
