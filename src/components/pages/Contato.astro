---
import { t } from "../../i18n/index.js";
import { REDES_ATIVAS, INSTAGRAM } from "../../data/redes.js";
import { GESTAO } from "../../data/gestao.js";
import IconeRede from "../IconeRede.astro";
import Cocais from "../Cocais.astro";

const { lang } = Astro.props;
const c = t(lang);
const k = c.contato;

// Só canais que têm texto explicativo escrito para esta página.
const canais = REDES_ATIVAS.filter((r) => k.canais.itens[r.id]);
---

<section class="topo">
  <Cocais canto="direita" cor="marrom" />
  <div class="wrap topo__inner">
    <p class="eyebrow">{k.hero.eyebrow}</p>
    <h1>{k.hero.titulo}</h1>
    <p class="lead">{k.hero.lead}</p>
  </div>
</section>

<!-- ============================== CANAIS ============================== -->
<section class="section-tight">
  <div class="wrap">
    <div class="section-head">
      <h2>{k.canais.titulo}</h2>
    </div>
    <div class="canais">
      {
        canais.map((r) => (
          <a
            class="card canal"
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="canal__icone"><IconeRede id={r.id} size={22} /></span>
            <h3>{r.rotulo}</h3>
            <p class="canal__handle">{r.handle}</p>
            <p>{k.canais.itens[r.id]}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- =========================== ONDE ESTAMOS =========================== -->
<section class="section section--warm">
  <div class="wrap local">
    <div class="local__texto">
      <h2>{k.local.titulo}</h2>
      <p class="local__campus">{k.local.campus}</p>
      <p class="local__sala">{k.local.sala}</p>
      <p>{k.local.texto}</p>
    </div>

    <div class="pessoas">
      <h2>{k.pessoas.titulo}</h2>
      <p class="muted">{k.pessoas.lead}</p>
      <ul>
        {
          GESTAO.map((p) => (
            <li class="pessoa">
              <span class="pessoa__seta" aria-hidden="true"></span>
              <span class="pessoa__nome">{p.nome}</span>
              <span class="pessoa__cargo">{p.cargo[lang] ?? p.cargo.pt}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- ============================== ENTRAR ============================== -->
<section class="section" id="entrar">
  <div class="wrap-narrow entrar">
    <h2>{k.entrar.titulo}</h2>
    {k.entrar.paragrafos.map((p) => <p class="prose">{p}</p>)}
    {
      INSTAGRAM?.url && (
        <p class="entrar__acao">
          <a
            class="btn btn--primary"
            href={INSTAGRAM.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconeRede id="instagram" size={20} />
            {k.entrar.cta}
          </a>
        </p>
      )
    }
  </div>
</section>

<!-- ================================ FAQ ================================ -->
<section class="section-tight section--warm">
  <div class="wrap-narrow">
    <h2 class="faq__titulo">{k.faq.titulo}</h2>
    <div class="faq">
      {
        k.faq.itens.map((item) => (
          <details class="faq__item">
            <summary>
              {item.p}
              <span class="faq__sinal" aria-hidden="true"></span>
            </summary>
            <p>{item.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .topo {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70% 130% at 78% 0%, rgba(242, 182, 32, 0.24) 0%, rgba(242, 182, 32, 0) 60%),
      linear-gradient(180deg, var(--bg-warm) 0%, var(--bg) 100%);
    padding-block: var(--space-xl) var(--space-l);
  }

  .topo__inner { position: relative; z-index: 1; }
  .topo__inner > * + * { margin-top: var(--space-s); }
  .topo__inner .lead { max-width: 50ch; }

  /* ----------------------------- CANAIS ----------------------------- */
  .canais {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    max-width: 52rem;
  }

  .canal { text-decoration: none; }
  .canal > * + * { margin-top: var(--space-2xs); }

  .canal__icone {
    display: inline-grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: var(--radius-s);
    background: var(--gold-soft);
    color: var(--gold-deep);
    margin-bottom: var(--space-2xs);
  }

  .canal__handle {
    font-weight: 700;
    color: var(--teal-deep);
    overflow-wrap: anywhere;
  }

  /* -------------------------- ONDE / PESSOAS -------------------------- */
  .local {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: start;
  }

  @media (max-width: 820px) {
    .local { grid-template-columns: 1fr; gap: var(--space-l); }
  }

  .local__texto > * + * { margin-top: var(--space-xs); }
  .local__texto p { max-width: 52ch; }

  .local__campus {
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--ink);
  }

  .local__sala {
    font-weight: 700;
    color: var(--gold-deep);
  }

  .pessoas > * + * { margin-top: var(--space-xs); }

  .pessoas ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .pessoa {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.7rem;
    align-items: center;
  }

  .pessoa__seta {
    grid-row: span 2;
    width: 1rem;
    height: 1rem;
    background: var(--gold);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .pessoa__nome {
    font-weight: 800;
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .pessoa__cargo {
    color: var(--ink-muted);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
  }

  /* ----------------------------- ENTRAR ----------------------------- */
  .entrar > * + * { margin-top: var(--space-s); }
  .entrar__acao { margin-top: var(--space-m); }

  /* ------------------------------- FAQ ------------------------------- */
  .faq__titulo { margin-bottom: var(--space-m); }

  .faq {
    display: grid;
    gap: var(--space-xs);
  }

  .faq__item {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 0;
    overflow: hidden;
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker { display: none; }

  .faq__item summary:hover { background: var(--bg-warm); }

  /* Sinal de + que vira × quando aberto, desenhado com duas barras. */
  .faq__sinal {
    position: relative;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s var(--ease);
  }

  .faq__sinal::before,
  .faq__sinal::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--gold-deep);
    border-radius: 2px;
  }

  .faq__sinal::before { width: 100%; height: 2.5px; }
  .faq__sinal::after { width: 2.5px; height: 100%; }

  .faq__item[open] .faq__sinal { transform: rotate(45deg); }

  .faq__item > p {
    padding: 0 var(--space-m) var(--space-s);
    max-width: 62ch;
  }
</style>
