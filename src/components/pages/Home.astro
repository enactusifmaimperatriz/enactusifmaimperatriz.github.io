---
import { t, href } from "../../i18n/index.js";
import { GLOBAL, TIME } from "../../data/rede-enactus.js";
import { INSTAGRAM } from "../../data/redes.js";
import { PROJETOS } from "../../data/projetos.js";
import { FOTOS_CAMPO } from "../../data/fotos-campo.js";
import { CONQUISTAS, IMPRENSA, FOTO_CONQUISTA } from "../../data/conquistas.js";
import IconeRede from "../IconeRede.astro";
import Faixa from "../Faixa.astro";
import Cocais from "../Cocais.astro";
import Galeria from "../Galeria.astro";

const { lang } = Astro.props;
const c = t(lang);
const h = c.home;

// Só mostra o quadro de números quando existir número de verdade.
const numerosTime = TIME.filter((n) => n.valor && n.valor !== "—");

// Foto do time que acompanha a marca no topo (a primeira de "o time em campo").
const fotoHero = FOTOS_CAMPO[0] ?? null;

// Registros: capa e galeria dos projetos, mais o time em campo. Até seis.
const registros = [
  ...PROJETOS.flatMap((p) => [
    p.capa
      ? { arquivo: p.capa, alt: p.capaAlt, legenda: { pt: p.nome, en: p.nome } }
      : null,
    ...(p.galeria ?? []),
  ]),
  ...FOTOS_CAMPO.map((f) => ({ ...f, arquivo: `campo/${f.arquivo}` })),
]
  .filter(Boolean)
  .slice(0, 6);
---

<!-- ============================== HERO ============================== -->
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__texto">
      <p class="eyebrow revelar">{h.hero.eyebrow}</p>
      <p class="assinatura hero__assinatura revelar" data-atraso="1">{h.hero.assinatura}</p>
      <h1 class="revelar" data-atraso="1">{h.hero.titulo}</h1>
      <p class="lead revelar" data-atraso="2">{h.hero.lead}</p>
      <div class="hero__acoes revelar" data-atraso="3">
        <a class="btn btn--primary" href={href("projects", lang)}>{h.hero.ctaPrimaria}</a>
        <a class="btn btn--marinho" href={`${href("contact", lang)}#entrar`}>{h.hero.ctaSecundaria}</a>
      </div>
    </div>

    <div class="hero__visual revelar" data-atraso="1">
      <!-- curva de território: forma orgânica em amarelo, atrás da composição -->
      <svg class="hero__curva" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
        <path d="M 468 58 C 562 108 604 226 572 326 C 540 426 472 522 352 562 C 232 602 102 562 48 452 C -6 342 28 198 118 118 C 208 38 378 10 468 58 Z" />
      </svg>

      {
        fotoHero && (
          <figure class="polaroid hero__polaroid">
            <img
              src={`/fotos/campo/${fotoHero.arquivo}`}
              alt={fotoHero.alt?.[lang] ?? fotoHero.alt?.pt ?? ""}
              width="953"
              height="565"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="assinatura">{h.hero.fotoNota}</figcaption>
          </figure>
        )
      }

      <img
        class="hero__marca"
        src="/brand/logo-time.png"
        alt={h.hero.creditoImagem}
        width="640"
        height="609"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<Faixa cor="amarelo" />

<!-- =========================== CONQUISTAS ===========================
     Vem logo depois do topo de propósito: é a credencial mais forte do
     time e o que faz um visitante decidir continuar lendo. -->
<section class="section section--marinho conquistas">
  <div class="wrap conquistas__inner">
    <div class="conquistas__texto">
      <p class="eyebrow revelar">{h.conquistas.eyebrow}</p>
      <h2 class="revelar" data-atraso="1">{h.conquistas.titulo}</h2>
      <p class="lead revelar" data-atraso="2">{h.conquistas.lead}</p>

      <ul class="premios">
        {
          CONQUISTAS.map((cq, i) => (
            <li class="premio revelar" data-atraso={String(Math.min(i + 1, 3))}>
              <span class="premio__ano">{cq.ano}</span>
              <h3>{cq.titulo[lang] ?? cq.titulo.pt}</h3>
              <p class="premio__onde">{cq.onde[lang] ?? cq.onde.pt}</p>
              <p class="premio__texto">{cq.texto[lang] ?? cq.texto.pt}</p>
            </li>
          ))
        }
      </ul>

      {
        IMPRENSA.length > 0 && (
          <div class="imprensa revelar" data-atraso="3">
            <p class="imprensa__rotulo">{h.conquistas.imprensa}</p>
            <ul>
              {IMPRENSA.map((m) => (
                <li>
                  <a href={m.url} target="_blank" rel="noopener noreferrer">
                    <span class="imprensa__veiculo">{m.veiculo}</span>
                    <span class="imprensa__titulo">{m.titulo[lang] ?? m.titulo.pt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <figure class="polaroid conquistas__foto revelar" data-atraso="2">
      <img
        src={`/fotos/${FOTO_CONQUISTA.arquivo}`}
        alt={FOTO_CONQUISTA.alt[lang] ?? FOTO_CONQUISTA.alt.pt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{h.conquistas.fotoLegenda}</figcaption>
    </figure>
  </div>
</section>

<!-- ==================== NÚMEROS DO TIME ====================
     Só aparece quando existir número de verdade em rede-enactus.js. -->
{
  numerosTime.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{h.numeros.eyebrow}</p>
          <h2>{h.numeros.titulo}</h2>
          <p>{h.numeros.lead}</p>
        </div>
        <dl class="numeros">
          {numerosTime.map((n) => (
            <div class="numeros__item">
              <dt>{h.numeros.rotulos[n.chave]}</dt>
              <dd>{n.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<!-- =========================== COMO ATUAMOS =========================== -->
<section class="section section--areia metodo">
  <Cocais canto="direita" cor="oliva" />
  <div class="wrap metodo__inner">
    <div class="section-head">
      <p class="eyebrow revelar">{h.comoAtuamos.eyebrow}</p>
      <h2 class="revelar" data-atraso="1">{h.comoAtuamos.titulo}</h2>
      <p class="lead revelar" data-atraso="2">{h.comoAtuamos.lead}</p>
    </div>

    <ol class="etapas">
      {
        h.comoAtuamos.etapas.map((e, i) => (
          <li class="etapa revelar" data-atraso={String(Math.min(i, 3))}>
            <span class="etapa__num" aria-hidden="true">{e.numero}</span>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ============================== A REDE ============================== -->
<section class="section section--profundo">
  <div class="wrap rede">
    <div class="rede__texto">
      <p class="eyebrow revelar">{h.redePreview.eyebrow}</p>
      <h2 class="revelar" data-atraso="1">{h.redePreview.titulo}</h2>
      <p class="revelar" data-atraso="2">{h.redePreview.texto}</p>
      <p class="revelar" data-atraso="3">
        <a class="btn btn--primary" href={href("enactus", lang)}>{h.redePreview.cta}</a>
      </p>
    </div>

    <dl class="rede__numeros">
      {
        GLOBAL.map((n) => (
          <div>
            <dd data-contar>{n.valor}</dd>
            <dt>{h.redePreview.rotulos[n.chave]}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- ============================= PROJETOS ============================= -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow revelar">{h.projetosPreview.eyebrow}</p>
      <h2 class="revelar" data-atraso="1">{h.projetosPreview.titulo}</h2>
      <p class="lead revelar" data-atraso="2">{h.projetosPreview.lead}</p>
    </div>

    <ul class="previa">
      {
        PROJETOS.map((proj) => {
          const resumo = proj.resumo?.[lang] || proj.resumo?.pt || "";
          return (
            <li class="revelar" data-atraso="2">
              <a class="card previa__card" href={href("projects", lang)}>
                {proj.capa && (
                  <figure class="recorte previa__capa">
                    <img
                      src={`/fotos/${proj.capa}`}
                      alt={proj.capaAlt?.[lang] ?? proj.capaAlt?.pt ?? ""}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                )}
                <div class="previa__texto">
                  <span class={`selo selo--${proj.status}`}>{c.projetos.status[proj.status]}</span>
                  <h3>{proj.nome}</h3>
                  <p>{resumo || h.projetosPreview.vazio}</p>
                  <span class="previa__link">{c.projetos.rotulos.verProjeto} &rarr;</span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="previa__acao revelar" data-atraso="3">
      <a class="btn btn--ghost" href={href("projects", lang)}>{h.projetosPreview.cta}</a>
    </p>
  </div>
</section>

<Faixa cor="marinho" virar />

<!-- ============================= REGISTROS ============================= -->
{
  registros.length > 0 && (
    <section class="section section--areia">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow revelar">{h.registros.eyebrow}</p>
          <h2 class="revelar" data-atraso="1">{h.registros.titulo}</h2>
          <p class="lead revelar" data-atraso="2">{h.registros.lead}</p>
        </div>
        <Galeria itens={registros} base="/fotos" lang={lang} estilo="polaroid" />
      </div>
    </section>
  )
}

<!-- ============================= PARTICIPE ============================= -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow revelar">{h.participe.eyebrow}</p>
      <h2 class="revelar" data-atraso="1">{h.participe.titulo}</h2>
    </div>

    <div class="grid caminhos">
      {
        h.participe.caminhos.map((cam, i) => (
          <article class="card caminho revelar" data-atraso={String(i + 1)}>
            <p class="caminho__publico">{cam.publico}</p>
            <h3>{cam.titulo}</h3>
            <p>{cam.texto}</p>
            <p>
              <a
                class={i === 0 ? "btn btn--primary" : "btn btn--marinho"}
                href={i === 0 ? `${href("contact", lang)}#entrar` : href("contact", lang)}
              >
                {cam.cta}
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============================= INSTAGRAM ============================= -->
{
  INSTAGRAM?.url && (
    <section class="section section--amarelo insta">
      <div class="wrap insta__inner">
        <div class="insta__texto">
          <p class="eyebrow revelar">{h.instagram.eyebrow}</p>
          <h2 class="revelar" data-atraso="1">{h.instagram.titulo}</h2>
          <p class="revelar" data-atraso="2">{h.instagram.texto}</p>
        </div>

        <a
          class="btn btn--profundo insta__cta revelar"
          data-atraso="2"
          href={INSTAGRAM.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <IconeRede id="instagram" size={20} />
          {h.instagram.cta}
        </a>
      </div>
    </section>
  )
}

<style>
  /* ------------------------------ HERO ------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
  }

  .hero__texto > * + * { margin-top: var(--space-s); }
  .hero__assinatura { margin-top: var(--space-m); }
  .hero__texto h1 { font-size: var(--step-5); margin-top: var(--space-2xs); }
  .hero__texto .lead { max-width: 52ch; }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  /* Composição: curva amarela ao fundo, polaroide do time por cima,
     e a marca oficial (intacta) flutuando na frente. */
  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }

  .hero__curva {
    position: absolute;
    left: -6%;
    top: -4%;
    width: 112%;
    height: 108%;
    fill: var(--amarelo);
    z-index: 0;
  }

  .hero__polaroid {
    position: absolute;
    top: 5%;
    right: 1%;
    width: 68%;
    --inclinacao: -4deg;
    z-index: 1;
  }

  .hero__polaroid img { aspect-ratio: 16 / 10; }

  .hero__marca {
    position: absolute;
    left: 0;
    bottom: 3%;
    width: 46%;
    z-index: 2;
    filter: drop-shadow(0 16px 30px rgba(46, 19, 13, 0.28));
    animation: flutuar 9s var(--ease) infinite;
  }

  @keyframes flutuar {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 880px) {
    .hero { padding-block: var(--space-l) var(--space-xl); }
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-l); }
    .hero__visual { order: -1; max-width: 22rem; }
    .hero__texto h1 { font-size: var(--step-4); }
  }

  /* ---------------------------- NÚMEROS ---------------------------- */
  .numeros {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    border-top: 2px solid var(--line);
    padding-top: var(--space-m);
  }

  .numeros__item dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .numeros__item dd {
    margin: 0.1em 0 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }

  /* --------------------------- CONQUISTAS --------------------------- */
  .conquistas__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-xl);
    align-items: center;
  }

  @media (max-width: 880px) {
    .conquistas__inner { grid-template-columns: 1fr; gap: var(--space-l); }
  }

  .conquistas__texto > * + * { margin-top: var(--space-s); }
  .conquistas__texto .lead { color: var(--ink-on-dark-muted); max-width: 48ch; }

  .conquistas__foto {
    --inclinacao: 2.5deg;
    max-width: 30rem;
    margin-inline: auto;
  }

  .conquistas__foto img { aspect-ratio: 3 / 2; }

  .premios {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .premio {
    border-left: 3px solid var(--amarelo);
    padding-left: var(--space-s);
  }

  .premio__ano {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--amarelo);
  }

  .premio h3 { color: var(--ink-on-dark); margin-top: 0.1em; }

  .premio__onde {
    color: var(--amarelo);
    font-size: var(--step--1);
    font-weight: 600;
    margin-top: 0.15em;
  }

  .premio__texto {
    color: var(--ink-on-dark-muted);
    font-size: var(--step--1);
    line-height: 1.55;
    margin-top: 0.35em;
    max-width: 46ch;
  }

  /* ---------------------------- IMPRENSA ---------------------------- */
  .imprensa {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid rgba(250, 244, 234, 0.18);
  }

  .imprensa__rotulo {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amarelo);
    margin-bottom: var(--space-2xs);
  }

  .imprensa ul { list-style: none; padding: 0; display: grid; gap: var(--space-2xs); }

  .imprensa a {
    display: grid;
    gap: 0.1em;
    text-decoration: none;
    padding: 0.4rem 0.6rem;
    margin-left: -0.6rem;
    border-radius: var(--radius-s);
    transition: background-color 0.18s var(--ease);
  }

  .imprensa a:hover { background: rgba(242, 182, 32, 0.14); }

  .imprensa__veiculo {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-on-dark-muted);
  }

  .imprensa__titulo {
    color: var(--ink-on-dark);
    font-weight: 600;
    line-height: 1.4;
  }

  .imprensa a:hover .imprensa__titulo { color: var(--amarelo); }

  /* ----------------------------- MÉTODO ----------------------------- */
  .metodo { overflow: hidden; }
  .metodo__inner { position: relative; z-index: 1; }

  /* 4 colunas no desktop, 2 no tablet, 1 no celular.
     Evita a quebra 3+1, que deixa uma etapa órfã na segunda linha. */
  .etapas {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    padding: 0;
  }

  @media (max-width: 1000px) {
    .etapas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .etapas { grid-template-columns: 1fr; }
  }

  .etapa {
    position: relative;
    padding-top: var(--space-m);
    border-top: 3px solid var(--amarelo);
  }

  .etapa > * + * { margin-top: var(--space-2xs); }

  .etapa__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--marrom);
  }

  /* ------------------------------ REDE ------------------------------ */
  .rede {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
  }

  .rede__texto > * + * { margin-top: var(--space-s); }
  .rede__texto p { color: var(--ink-on-dark-muted); max-width: 58ch; }

  .rede__numeros {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
  }

  .rede__numeros > div {
    border-left: 3px solid var(--amarelo);
    padding-left: var(--space-xs);
  }

  .rede__numeros dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink-on-dark);
    line-height: 1.05;
  }

  .rede__numeros dt {
    font-size: 0.78rem;
    color: var(--ink-on-dark-muted);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
  }

  @media (max-width: 880px) {
    .rede { grid-template-columns: 1fr; gap: var(--space-l); }
  }

  /* ------------------------- PRÉVIA DE PROJETOS ------------------------- */
  .previa {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }

  .previa__card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-l);
    align-items: center;
    padding: var(--space-m);
  }

  .previa__card > * + * { margin-top: 0; }

  @media (max-width: 760px) {
    .previa__card { grid-template-columns: 1fr; gap: var(--space-m); }
  }

  .previa__capa img { aspect-ratio: 4 / 3; }

  .previa__texto > * + * { margin-top: var(--space-xs); }

  .previa__link {
    display: inline-block;
    margin-top: var(--space-s);
    font-weight: 700;
    color: var(--marinho);
  }

  .previa__acao { margin-top: var(--space-m); }

  .selo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.22em 0.7em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .selo::before {
    content: "";
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
  }

  .selo--ativo { background: rgba(38, 76, 107, 0.12); color: var(--petroleo); }
  .selo--piloto { background: rgba(242, 182, 32, 0.22); color: var(--marrom); }
  .selo--concluido { background: rgba(111, 57, 26, 0.12); color: var(--marrom); }

  /* ---------------------------- CAMINHOS ---------------------------- */
  .caminhos { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }

  .caminho__publico {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--petroleo);
  }

  .caminho > p:last-child { margin-top: var(--space-s); }

  /* ---------------------------- INSTAGRAM ---------------------------- */
  .insta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l);
  }

  .insta__texto { max-width: 52ch; }
  .insta__texto > * + * { margin-top: var(--space-xs); }
  .insta__texto h2 { font-size: var(--step-3); }

  .insta__cta { flex-shrink: 0; }

  @media (max-width: 620px) {
    .insta__cta { width: 100%; }
  }
</style>
