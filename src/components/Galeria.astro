---
/**
 * Galeria de fotos. Recebe uma lista de itens no formato:
 *   { arquivo, alt: { pt, en }, legenda?: { pt, en } }
 *
 * `base` é a pasta dentro de public onde estão os arquivos,
 * por exemplo "/fotos/campo".
 *
 * Se a lista chegar vazia, o componente não renderiza nada.
 */
const { itens = [], base = "/fotos", lang = "pt" } = Astro.props;
const fotos = itens.filter((i) => i && i.arquivo);
---

{
  fotos.length > 0 && (
    <ul class="galeria" data-total={fotos.length}>
      {fotos.map((f, i) => (
        <li class="galeria__item">
          <figure>
            <img
              src={`${base}/${f.arquivo}`}
              alt={f.alt?.[lang] ?? f.alt?.pt ?? ""}
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
            {f.legenda?.[lang] && <figcaption>{f.legenda[lang]}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  )
}

<style>
  .galeria {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  /* A primeira foto ocupa duas colunas, o que dá hierarquia à galeria
     em vez de deixar uma grade uniforme e sem foco. */
  .galeria[data-total="1"] { grid-template-columns: minmax(0, 1fr); }

  @media (min-width: 800px) {
    .galeria:not([data-total="1"]):not([data-total="2"]) .galeria__item:first-child {
      grid-column: span 2;
    }
  }

  .galeria figure { margin: 0; }

  .galeria img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-m);
    background: var(--bg-warm);
    border: 1px solid var(--line);
  }

  .galeria figcaption {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
