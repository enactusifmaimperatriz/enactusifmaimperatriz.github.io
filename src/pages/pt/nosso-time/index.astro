---
import Base from "../../../layouts/Base.astro";
import EmConstrucao from "../../../components/pages/EmConstrucao.astro";
import { t } from "../../../i18n/index.js";

const lang = "pt";
const c = t(lang);
const titulo = c.nav.team;
---

<Base
  lang={lang}
  routeKey="team"
  title={`${titulo} | ${c.site.nome}`}
  description={c.footer.sobre}
>
  <EmConstrucao lang={lang} titulo={titulo} />
</Base>
