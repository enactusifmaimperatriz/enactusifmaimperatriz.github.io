---
import Base from "../../../layouts/Base.astro";
import Enactus from "../../../components/pages/Enactus.astro";
import { t } from "../../../i18n/index.js";

const lang = "pt";
const c = t(lang);
---

<Base
  lang={lang}
  routeKey="enactus"
  title={c.enactus.meta.title}
  description={c.enactus.meta.description}
>
  <Enactus lang={lang} />
</Base>
